  <%= link_to root_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-arrow-left"></i>
    Retour à l'accueil
  <% end %>

  <h1 id="chat_title" class="text-center mt-4">
    <%= @chat.title %>
  </h1>

  <div class="text-center my-5">
    <p class="text-secondary">
      Découvrez les films sélectionnés selon vos goûts.
    </p>
  </div>

  <div id="messages">
    <% @chat.messages.order(:created_at).each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </div>

  <div id="new_message_container">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>

<div id="change_title">
  <%= render "messages/form2", chat: @chat %>
</div>
