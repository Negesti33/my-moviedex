<section class="home-hero" data-controller="change-chat">
  <h1 class="home-hero__title">Mes Tchats</h1>
  <div class="my-3">
    <% @chats.each do |chat| %>
      <div class="card shadow-sm h-100 border-0">
        <div class="card-body d-flex align-items-center justify-content-center">
          <%= link_to chat_path(chat) do %>
            <h5 class="card-title mb-0 me-3"><%= chat.title %></h5>
          <% end %>
          <%= link_to chat_path(chat), class: "secondary-action" do %>
            <i class="fa-solid fa-pen-to-square me-3 opacity-50" data-action="click->change-chat#modify"></i>
          <% end %>
          <%= link_to chat_path(chat), data: {turbo_method: :delete}, class: "secondary-action" do  %>
            <i class="fa-solid fa-trash-can opacity-50" data-action="click->change-chat#delete"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <%= button_to "Nouveau chat", chats_path, class: "btn-gradient" %>
</section>
